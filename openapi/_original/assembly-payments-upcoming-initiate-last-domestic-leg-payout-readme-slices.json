        "description": "Building name",
        "example": "123"
       },
       "floor": {
        "maxLength": 70,
        "minLength": 1,
        "type": "string",
        "description": "Floor. New in this version.",
        "example": "4"
       },
       "post_box": {
        "maxLength": 16,
        "minLength": 1,
        "type": "string",
        "description": "Post box. New in this version.",
        "example": "123"
       },
       "room": {
        "maxLength": 70,
        "minLength": 1,
        "type": "string",
        "description": "Room. New in this version.",
        "example": "1"
       },
       "postcode": {
        "maxLength": 16,
        "minLength": 1,
        "type": "string",
        "description": "Post Code",
        "example": "2000"
       },
       "town_name": {
        "maxLength": 35,
        "minLength": 1,
        "type": "string",
        "description": "Town name",
        "example": "Sydney"
       },
       "town_location": {
        "maxLength": 35,
        "minLength": 1,
        "type": "string",
        "description": "Town location. New in this version.",
        "example": "Sydney"
