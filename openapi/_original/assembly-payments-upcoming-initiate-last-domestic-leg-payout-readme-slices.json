          "$ref": "#/components/schemas/ifti_address_v4"
         }
        ]
       },
       "organisation_identification": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/generic_identification_v4"
        }
       },
       "organisation_bic": {
        "pattern": "[A-Z]{6,6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3,3}){0,1}",
        "type": "string",
        "example": "SMPLAU2SXXX"
       },
       "private_identification": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/generic_identification_v4"
        }
       },
       "date_place_of_birth": {
        "$ref": "#/components/schemas/date_and_place_of_birth"
       }
      }
     },
     "generic_identification_v4": {
      "description": "Identification group: `{ lei, other: [...] }`, replacing the bare array of identification items used in the current live version.",
      "type": "object",
      "properties": {
       "lei": {
        "type": "string",
        "pattern": "[A-Z0-9]{18}[0-9]{2}",
