[
 {
  "page": "https://developer.hellozai.com/reference/npplastdomesticleg-1.md",
  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "[Upcoming] Initiate Last Domestic Leg Payout",
    "description": "\nThis document describes the Initiate Last Domestic Leg Payout endpoint update going live in 2027.\n\n For `POST /wallet_accounts/{id}/npp_last_domestic_leg`. See 'Initiate Last Domestic Leg Payout' under Wallet Accounts in the main API documentation  for the current live version.",
    "version": "2.4-ifti-v4",
    "contact": {
     "email": "support@assemblypayments.com",
     "url": "http://docs.assemblypayments.com/"
    }
   },
   "servers": [
    {
     "url": "https://test.api.promisepay.com",
     "description": "Pre-live environment"
    },
    {
     "url": "https://secure.api.promisepay.com",
     "description": "Production environment"
    }
   ],
   "x-explorer-enabled": false,
   "x-samples-languages": [
    "curl",
    "ruby",
    "php",
    "javascript",
    "csharp",
    "go"
   ],
   "paths": {
    "/wallet_accounts/{id}/npp_last_domestic_leg": {
     "post": {
      "tags": [
       "Wallet Accounts"
      ],
      "summary": "Initiate Last Domestic Leg Payout (Upcoming 2027)",
      "description": "Facilitate the real-time settlement of the last domestic leg payout for International Funds Transfer Instructions (IFTI) through NPP rails. This updated `ifti_information` payload shape goes live in 2027 and applies to accounts enabled for international funds transfer instructions. See 'Initiate Last Domestic Leg Payout' under Wallet Accounts in the main API documentation for the current live version.",
      "operationId": "nppLastDomesticLeg",
      "parameters": [
       {
        "name": "id",
        "in": "path",
        "description": "Wallet account ID",
        "required": true,
        "schema": {
         "type": "string",
         "default": "bd6e9c20-73f1-0138-fb91-0a58a9feac09"
        },
        "example": "bd6e9c20-73f1-0138-fb91-0a58a9feac09"
       }
      ],
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/npp_last_domestic_leg_requestBody"
         }
        }
       }
      },
      "responses": {
       "201": {
        "description": "OK",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "disbursements": {
             "$ref": "#/components/schemas/npp_last_domestic_leg_disbursement"
            }
           }
          },
