     "ifti_address_v4": {
      "type": "object",
      "description": "Address, used for creditor_address, party addresses, and related_remittance_information's\npostal_address. Adds bldg_number, floor, post_box, room, town_location, and district_name\ncompared to the current live version's address schema.",
      "properties": {
       "address_type": {
        "allOf": [
