     },
     "npp_last_domestic_leg_requestBody": {
      "type": "object",
      "required": [
       "account_id",
       "amount",
       "ifti_information",
       "end_to_end_id"
      ],
      "properties": {
       "account_id": {
        "description": "Account to withdraw to.",
        "type": "string",
        "example": "c1824ad0-73f1-0138-3700-0a58a9feac09",
        "default": "c1824ad0-73f1-0138-3700-0a58a9feac09"
       },
       "amount": {
        "description": "Amount (in cents) to withdraw.",
        "type": "integer",
        "example": "173",
        "default": "173"
       },
       "custom_descriptor": {
        "description": "A descriptor specified by the customer to be passed on the withdraw call. This requires that custom_descriptors are enabled. In the case of fast payments (AU / NPP) Assembly will append a value in the beginning of descriptor, the customer can use 200 characters (excluding URL, javascript/code, emojis). In the case of DE batch payments will allow 18 characters",
        "type": "string",
        "example": ""
       },
       "reference_id": {
        "description": "Unique reference information that can be specified for a for wallet withdrawal request. This is an optional field and cannot contain '.' character.",
        "type": "string",
        "example": "7190770-1-2908",
        "default": "7190770-1-2908"
       },
       "end_to_end_id": {
        "description": "A unique identifier assigned by the initiating party to track and reconcile the IFTI payout throughout its lifecycle. This value must be unique per transaction and is included in payment messaging for traceability across participating financial institutions. This is the Debtor’s (customer) reference for the Payment to be provided to Creditor (customer). Mandatory for NPP IFTI Payment.",
        "type": "string",
        "example": "PRTYAUXXXX",
        "default": "NOTPROVIDED"
       },
       "ifti_information": {
        "required": [
         "instruction_identification",
         "charge_bearer",
         "debtor",
         "debtor_account",
         "debtor_agent_information",
         "payment_information"
        ],
        "description": "IFTI Payer Information (updated shape, going live in 2027).\n\nThis is a required field and cannot contain invalid characters.\nPlease get in touch with customer service before enabling this feature.\n\nFields marked below are required exclusively for **IFTI payout processing to meet reporting and compliance\nrequirements**.\n\nPlease refer to individual field descriptions for specific conditional requirements.\n\nCompared to the current live version: `debtor`, `debtor_account`, and `debtor_agent_information` are new\nmandatory blocks; `ultimate_debtor_information` and `creditor_agent_instruction` are now optional;\n`previous_instructing_agent` is now an array (max 3); `contact_details` has been removed from all party\nblocks; and organisation/private identification is now `{ lei, other: [...] }` rather than a bare array.",
        "type": "object",
        "properties": {
         "instruction_identification": {
          "description": "A unique transaction reference number that identifies the\nfinal domestic payout request for NPP. It is recommended that this reference\nnumber matches the point-to-point transaction reference used in your Austrac reporting.\nMandatory for NPP IFTI Payment.",
          "type": "string",
          "maxLength": 35,
          "example": "BANKNTSTXXXI20180501000000000000010"
         },
         "local_clearing_option": {
          "description": "Local clearing option used for the domestic leg of the payment.",
          "type": "string",
          "example": "sample"
         },
         "debit_date_time": {
          "description": "Date and time the debtor's account was debited.",
          "type": "string",
          "format": "date-time"
         },
         "credit_date_time": {
          "description": "Date and time the creditor's account was credited.",
          "type": "string",
          "format": "date-time"
         },
         "cls_time": {
          "description": "CLS (Continuous Linked Settlement) time, when applicable.",
          "type": "string",
          "format": "date-time"
         },
         "uetr": {
          "description": "Unique End-to-end Transaction Reference (UETR) for the underlying international message. Optional.",
          "type": "string",
          "example": "de2da6c9-18be-48d4-8053-867ed90a316a"
         },
         "creditor_lei": {
          "description": "Legal Entity Identifier (LEI) of the creditor, when available. 20 characters: 18 alphanumeric + 2 numeric.",
          "type": "string",
          "pattern": "[A-Z0-9]{18}[0-9]{2}",
          "example": "529900T8BM49AURSDO55"
         },
         "debtor_lei": {
          "description": "Legal Entity Identifier (LEI) of the debtor, when available. 20 characters: 18 alphanumeric + 2 numeric.",
          "type": "string",
          "pattern": "[A-Z0-9]{18}[0-9]{2}",
          "example": "213800WSGIIZCXF1P572"
         },
         "instructed_amount": {
          "description": "Transaction Amount. This is the amount originated in foreign currency.",
          "type": "object",
          "properties": {
           "currency": {
            "type": "string",
            "example": "AUD"
           },
           "amount": {
            "type": "string",
            "example": "3.25"
           }
          }
         },
         "exchange_rate": {
          "description": "Exchange rate used for AUD FX conversion.  Mandatory for IFTI if present in the source international message.",
          "type": "string",
          "example": "1.23"
         },
         "charge_bearer": {
          "description": "Specifies which party/parties will bear the charges of processing payment transaction.\n\nValid values -\n'CRED' (Borne by Creditor),\n'DEBT' (Borne by Debtor),\n'SHAR' (Shared),\n'SLEV' (Following Service Level).",
          "type": "string",
          "enum": [
           "CRED",
           "DEBT",
           "SHAR",
           "SLEV"
          ],
          "example": "CRED"
         },
         "charges_information": {
          "description": "Charges applied by agents along the payment chain. Array, max 3 items.  When an item is present, its `amount` and `agent_bic` are required.",
          "type": "array",
          "maxItems": 3,
          "items": {
           "type": "object",
           "properties": {
            "amount": {
             "type": "object",
             "properties": {
              "currency": {
               "type": "string",
               "example": "AUD"
              },
              "amount": {
               "type": "string",
               "example": "3.25"
              }
             }
            },
            "agent_bic": {
             "type": "string",
             "example": "YOURBIC1234"
            }
           }
          }
         },
         "payment_purpose_proprietary": {
          "description": "Refers to a code or description used to specify the reason or purpose for the payment. This information is often provided by the sender to clarify the intent of the transfer, such as payment for goods, services, or a personal remittance. Mandatory for IFTI if present in the source international message.",
          "type": "string",
          "example": "Prtry"
         },
         "previous_instructing_agent": {
          "description": "This identifies the agent or remitter's bank that instructs the intermediary bank or NPP payer participant to clear funds, typically for bulk or aggregated transfers to your account. Each entry can either be the agent_bic OR clearing system identification and clearing system member identification. **Now an array (max 3 items) - was a single object in the current live version.**",
          "type": "array",
          "maxItems": 3,
          "items": {
           "type": "object",
           "properties": {
            "agent_bic": {
             "type": "string",
             "example": "YOURBIC1234"
            },
            "clearing_system_identification": {
             "type": "string",
             "example": "BICCODE123"
            },
            "clearing_system_member_identification": {
             "type": "string",
             "example": "BICCODE123MEM"
            }
           }
          }
         },
         "creditor_address": {
          "description": "Address of the creditor's bank/branch. New in this version.",
          "allOf": [
           {
            "$ref": "#/components/schemas/ifti_address_v4"
           }
          ]
         },
         "creditor_agent_instruction": {
          "description": "Refers to additional details or instructions provided to the bank or financial institution responsible for crediting the funds to the recipient (the creditor). These instructions are provided by the initiating party and help the creditor agent accurately complete the transfer. **Now optional - was mandatory in the current live version.** Sent as-is (the current live version prefixed instruction_information with a BIC smuggling convention no longer needed now that debtor_agent_information exists).",
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "instruction_information": {
             "type": "string",
             "maxLength": 140,
             "example": "sample"
            },
            "code": {
             "type": "string",
             "enum": [
              "CHQB",
              "HOLD",
              "PHOB",
              "TELB"
             ],
             "example": "CHQB"
            }
           }
          }
         },
         "next_agent_instruction": {
          "description": "Free-text instructions for the next agent in the payment chain. Array, max 3 items.",
          "type": "array",
          "maxItems": 3,
          "items": {
           "type": "string"
          },
          "example": [
           "INSTRUCTION_001"
          ]
         },
         "regulatory_reporting": {
          "description": "Refers to the obligation to report certain transaction details to regulatory authorities to comply with anti-money laundering (AML), counter-terrorism financing (CTF), and other financial regulations. Array, max 10 items.",
          "type": "array",
          "maxItems": 10,
          "items": {
           "type": "object",
           "properties": {
            "reporting_type": {
             "type": "string",
             "example": "sample"
            },
            "authority_name": {
             "description": "Refers to the name of the regulatory body or financial authority to which the payment details are reported for compliance purposes. This is typically a government or financial intelligence agency that monitors transactions for anti-money laundering (AML) and counter-terrorism financing (CTF) efforts.",
             "type": "string",
             "example": "Name"
            },
            "authority_country": {
             "type": "string",
             "pattern": "[A-Z]{2,2}",
             "example": "AU"
            },
            "details": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "type": {
                "type": "string"
               },
               "date": {
                "type": "string",
                "format": "date"
               },
               "country": {
                "type": "string",
                "pattern": "[A-Z]{2,2}"
               },
               "code": {
                "type": "string"
               },
               "amount": {
                "type": "object",
                "properties": {
                 "currency": {
                  "type": "string",
                  "example": "AUD"
                 },
                 "amount": {
                  "type": "string",
                  "example": "3.25"
                 }
                }
               },
               "information": {
                "type": "array",
                "items": {
                 "type": "string"
                }
               }
              }
             }
            }
           }
          }
         },
         "remittance_information_structured": {
          "description": "This is now an object whose only property is `referred_document_information` (array, max 3 items). All other sub-fields from the current live version (tax, garnishment, creditor reference, invoicer/invoicee) have been removed.",
          "type": "object",
          "properties": {
           "referred_document_information": {
            "type": "array",
            "maxItems": 3,
            "items": {
             "type": "object",
             "properties": {
              "code": {
               "type": "string",
               "example": "sample"
              },
              "proprietary": {
               "type": "string",
               "example": "sample"
              },
              "issuer": {
               "type": "string",
               "example": "sample"
              },
              "number": {
               "type": "string",
               "example": "sample"
              },
              "related_date": {
               "type": "string",
               "format": "date"
              }
             }
            }
           }
          }
         },
         "related_remittance_information": {
          "description": "Array, max 10 items. `location_details.name` has been removed - it is logged and dropped if still supplied.",
          "type": "array",
          "maxItems": 10,
          "items": {
           "type": "object",
           "properties": {
            "identification": {
             "type": "string",
             "example": "S010"
            },
            "location_details": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "method": {
                "type": "string",
                "example": "sample"
               },
               "electronic_address": {
                "type": "string",
                "example": "sample"
               },
               "postal_address": {
                "allOf": [
                 {
                  "$ref": "#/components/schemas/ifti_address_v4"
                 }
                ]
               }
              }
             }
            }
           }
          }
         },
         "service_level": {
          "description": "Pass-through of the service level values carried on the inbound international message. Array, max 3 items, each 1-35 characters (e.g. SEPA, BKTR, G001). Distinct from payment_information.service_level, which Zai populates automatically.",
          "type": "array",
          "maxItems": 3,
          "items": {
           "type": "string"
          },
          "example": [
           "URGENT"
          ]
         },
         "debtor": {
          "description": "The debtor party for the international leg. **New mandatory block.** Only `name` is required.",
          "allOf": [
           {
            "$ref": "#/components/schemas/party_identification_v4"
           }
          ]
         },
         "debtor_account": {
          "description": "The debtor's account for the international leg. **New mandatory block.** Either `iban` or `account_identification` must be present.",
          "type": "object",
          "properties": {
           "iban": {
            "type": "string",
            "example": "DE89370400440532013000"
           },
           "account_identification": {
            "type": "string",
            "example": "sample"
           },
           "account_identification_type_code": {
            "type": "string",
            "example": "BBAN"
           },
           "account_identification_issuer": {
            "type": "string",
            "pattern": "[0-9]{6}",
            "description": "6-digit BSB, when account_identification_type_code identifies a BSB-style account.",
            "example": "123456"
           }
          }
         },
         "debtor_agent_information": {
          "description": "The debtor's bank/agent for the international leg. **New mandatory block.** Either `bic` or `lei` must be present.",
          "type": "object",
          "properties": {
           "bic": {
            "pattern": "[A-Z]{6,6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3,3}){0,1}",
            "type": "string",
            "example": "DEUTDEDD"
           },
           "lei": {
            "type": "string",
            "pattern": "[A-Z0-9]{18}[0-9]{2}",
            "example": "529900T8BM49AURSDO55"
           },
           "name": {
            "type": "string",
            "maxLength": 140,
            "example": "sample"
           }
          }
         },
         "ultimate_debtor_information": {
          "description": "**Now optional - was mandatory in the current live version.** If provided, only `name` is required;\n`address` and `country_of_residence` are validated for format only when supplied.",
          "allOf": [
           {
            "$ref": "#/components/schemas/party_identification_v4"
           }
          ]
         },
         "ultimate_creditor_information": {
          "description": "The name of the final recipient of the funds, not including any intermediaries\nor account holders. Optional; if provided, only `name` is required.",
          "allOf": [
           {
            "$ref": "#/components/schemas/party_identification_v4"
           }
          ]
         },
         "initiating_party_information": {
          "description": "Optional, with no mandatory sub-fields. Unlike the other party blocks,\n`organisation_identification` and `private_identification` here are **arrays**\nof identification groups, not single objects.",
          "allOf": [
           {
            "$ref": "#/components/schemas/party_identification_v4_initiating"
           }
          ]
         },
         "payment_information": {
          "required": [
           "country_of_origin"
          ],
          "description": "**Mandatory block.** `country_of_origin` is mandatory; `service_level` is deliberately not accepted here (Zai injects the fixed value `sctxbrdr`) - use the top-level `service_level` field to pass through the customer's own service level values.",
          "type": "object",
          "properties": {
           "uetr": {
            "description": "Mirrored to the top-level `uetr` field if not already provided there.",
            "type": "string",
            "example": "de2da6c9-18be-48d4-8053-867ed90a316a"
           },
           "country_of_origin": {
            "description": "ISO 3166-1 alpha-2 country code of the payment's origin. Mandatory.",
            "type": "string",
            "pattern": "[A-Z]{2,2}",
            "example": "DE"
           },
           "remittance_information_unstructured": {
            "description": "Refers to additional, free-text details provided by the sender about the purpose or context of the payment.",
            "type": "string",
            "example": "MAP_RE_Happy"
           },
           "payment_purpose_code": {
            "description": "This refers to the standardized code that indicates the reason for the payment. It helps to identify the nature of the transaction for regulatory and compliance purposes. Refer to https://www.iso20022.org/catalogue-messages/additional-content-messages/external-code-sets for full list of Payment Purpose code.",
            "type": "string",
            "example": "EPAY"
           }
          }
         }
        }
       }
      }
     },
     "party_identification_v4": {
      "description": "Party identification. Unlike the current live version, `organisation_identification` and\n`private_identification` are single objects shaped `{ lei, other: [...] }` rather than a bare\narray, and `contact_details` has been removed.",
      "type": "object",
      "properties": {
       "name": {
        "maxLength": 140,
        "type": "string",
        "example": "John Doe"
       },
       "country_of_residence": {
        "pattern": "[A-Z]{2,2}",
        "type": "string",
        "example": "AU"
       },
       "address": {
        "allOf": [
         {
          "$ref": "#/components/schemas/ifti_address_v4"
         }
        ]
       },
       "organisation_identification": {
        "allOf": [
         {
          "$ref": "#/components/schemas/generic_identification_v4"
         }
        ]
       },
       "organisation_bic": {
        "pattern": "[A-Z]{6,6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3,3}){0,1}",
        "type": "string",
        "example": "SMPLAU2SXXX"
       },
       "private_identification": {
        "allOf": [
         {
          "$ref": "#/components/schemas/generic_identification_v4"
         }
        ]
       },
       "date_place_of_birth": {
        "$ref": "#/components/schemas/date_and_place_of_birth"
       }
      }
     },
     "party_identification_v4_initiating": {
      "description": "Party identification for `initiating_party_information` only. `organisation_identification`\nand `private_identification` are **arrays** of identification groups here, unlike every other\nparty block where they are single objects.",
      "type": "object",
      "properties": {
       "name": {
        "maxLength": 140,
        "type": "string",
        "example": "John Doe"
       },
       "country_of_residence": {
        "pattern": "[A-Z]{2,2}",
        "type": "string",
        "example": "AU"
       },
       "address": {
        "allOf": [
